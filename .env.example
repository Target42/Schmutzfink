# Lokal bleiben. Hinter Docker-Portmapping im Container :8787 setzen.
HTTP_ADDR=127.0.0.1:8787
DATABASE_URL=postgres://schmutzfink:schmutzfink@127.0.0.1:55432/schmutzfink?sslmode=disable
# Ablage: local (Standard) oder s3. Nur per Umgebung, kein UI.
STORAGE_BACKEND=local
STORAGE_DIR=./data/objects
# Extra-Partition, z. B. STORAGE_DIR=D:/Fotos/schmutzfink
# THUMB_CACHE_DIR=./data/_thumbs
#
# MinIO lokal: docker compose --profile s3 up -d
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=schmutzfink
# S3_REGION=us-east-1
# S3_ACCESS_KEY=schmutzfink
# S3_SECRET_KEY=schmutzfink
# S3_PREFIX=
# Erstes Konto nur bei leerer Datenbank, Rolle Admin. Passwort "admin" sperrt den Bestand bis zur Änderung.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# Optional: UI vom Datenträger statt aus dem Binary (lokal nach npm run build)
WEB_DIST=./web/dist
# Signierte Android-APK für Download im Portal (Sachbearbeiter/Admin). Fehlt die Datei, ist der Download aus.
# Sidecar optional: gleiche Basis mit .json (version, version_code, released_at, notes).
# MOBILE_APK_PATH=./data/mobile/schmutzfink-android.apk
# Sitzungscookie Secure: auto (HTTPS bzw. X-Forwarded-Proto nur bei vertrauenswürdigem Proxy), 1 immer, 0 nie
COOKIE_SECURE=auto
# Forwarded-Header: auto (nur Loopback-Peer), 1 hinter nginx/Docker-NAT, 0 nie
TRUST_PROXY=auto
#
# AD-Anmeldung (optional). Ablauf und Provisioning-API: README, Abschnitt „Active Directory“.
# Ohne LDAP_URL bleiben nur lokale Konten. Der API-Prozess muss den DC erreichen.
# LDAP_DOMAIN mit Punkt → Bind user@domain; ohne Punkt → DOMAIN\user.
# LDAP_URL=ldaps://dc.example.local:636
# LDAP_DOMAIN=example.local
# LDAP_BIND_TEMPLATE={username}@example.local
# LDAP_STARTTLS=0
# LDAP_INSECURE_SKIP_VERIFY=0
# PROVISION_TOKEN=
